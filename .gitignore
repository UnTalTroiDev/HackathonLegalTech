# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# datos de evaluación con información personal (no versionar)
/eval/pdfs/*
!/eval/pdfs/.gitkeep
/eval/casos.json

# typescript
*.tsbuildinfo
next-env.d.ts

# firecrawl scrapes (temporales)
/.firecrawl/

# Tooling de IA / skills (entorno de desarrollo, no la app)
/.agents/
/.claude/
/.codebuddy/
/.continue/
/.junie/
/.kiro/

# repo embebido (no versionar dentro de este repo)
/LegalTechHack/
/LegalTechHack
